# Local development requires no .env file. Never commit actual environment files.
APP_ENV=development
# DATABASE_URL may override the default working-directory-relative SQLite database.
# DATABASE_URL=
# Production: generate a new random SECRET_KEY privately (not this placeholder).
SECRET_KEY=replace-me-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Production must also set APP_ENV=production, SECURITY_BACKEND=redis,
# REDIS_URL to a protected Redis endpoint and FRONTEND_ORIGINS to a JSON array
# of exact HTTPS frontend origins. Use same-site HTTPS frontend/API hosts.
# SECURITY_BACKEND=redis
# REDIS_URL=
# FRONTEND_ORIGINS=
# Migrations and retention require separate explicit operator targets:
# MIGRATION_DATABASE_URL=
# RETENTION_DATABASE_URL=
